# Token from @BotFather
BOT_TOKEN=
# Your Telegram user id (ask @userinfobot); this user approves subscribers
ADMIN_CHAT_ID=
DONGLE_HOST=inverter.lan
DONGLE_PORT=8000
# 10-character serials of the WiFi dongle and of the inverter (LuxPower app, device list)
DONGLE_SERIAL=
INVERTER_SERIAL=
POLL_INTERVAL=15
SOC_LOW=30
SOC_CRITICAL=15
SOC_GEN_FULL=90
TZ=Europe/Kyiv
# Planned outage schedule (DTEK, via github.com/Baskerville42/outage-data-ua); empty turns it off
SCHEDULE_GROUP=3.2
SCHEDULE_MATCH_WINDOW=30
# A new or changed day goes out once it has held this long (DTEK sometimes edits it right after publishing)
SCHEDULE_SETTLE_MINUTES=20
# Battery runtime forecast; an empty capacity turns it off
BATTERY_CAPACITY_WH=16000
BATTERY_RESERVE_SOC=5
# Tuya smart home: run a tap-to-run scene when the grid goes (and, optionally, comes back).
# Keys: platform.tuya.com > Cloud > your project > Overview; empty keys turn it off.
TUYA_ACCESS_ID=
TUYA_ACCESS_SECRET=
TUYA_API_URL=https://openapi.tuyaeu.com
# Scene IDs: docker compose run --rm -T bot python -m tools.tuya_scenes --help
TUYA_SCENE_GRID_LOST=
TUYA_SCENE_GRID_RESTORED=
# While the grid is out, the grid-lost scene runs again this often (a device switched on meanwhile); 0 = once
TUYA_SCENE_REPEAT_MINUTES=10
# The inverter as a network UPS (NUT) for the NAS: DSM > Control Panel > Hardware & Power > UPS, "Synology UPS
# server" at this host's IP. Only these IPs may connect; empty turns it off.
NUT_ALLOWED_HOSTS=
# On battery at or below this charge the UPS reports a low battery, and DSM goes to Safe Mode
NUT_LOW_SOC=6
